
#include <iostream>
#include <fstream>
using namespace std;

double calculate(double gallons, double miles)
{
    return miles / gallons;
}

int main()
{
    ifstream file("trips.txt");
    double gallons, miles, mpg;
    double totalgallons = 0, totalmiles = 0;

    while (file >> gallons >> miles)
    {
        mpg = calculate(gallons, miles);

        cout << "Gallons: " << gallons << endl;
        cout << "Miles: " << miles << endl;
        cout << "MPG: " << mpg << endl;

        totalgallons += gallons;
        totalmiles += miles;
    }

    cout << "Total Gallons: " << totalgallons << endl;
    cout << "Total Miles: " << totalmiles << endl;

    file.close();
    return 0;
}


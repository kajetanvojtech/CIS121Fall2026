

#include <iostream>
#include <fstream>
#include <string>
using namespace std;

struct car {
    string make;
    string model;
    double msrp;
};

void load(car cars[]) {
    ifstream file("cars.txt");

    for (int i = 0; i < 10; i++) {
        file >> cars[i].make >> cars[i].model >> cars[i].msrp;
    }

    file.close();
}

void display(car cars[]) {
    for (int i = 0; i < 10; i++) {
        cout << cars[i].make << " "
             << cars[i].model << " $"
             << cars[i].msrp << endl;
    }
}

int main() {
    car cars[10];

    load(cars);
    display(cars);

    return 0;
}



#include <iostream>
#include <fstream>
#include <vector>
#include <string>
using namespace std;

struct student {
    string firstname;
    string lastname;
    double gpa;
};

void display(vector<student> students) {
    for (int i = 0; i < students.size(); i++) {
        cout << students[i].firstname << " "
             << students[i].lastname << " "
             << students[i].gpa << endl;
    }
}

int main() {
    vector<student> students;
    student s;

    ifstream file("students.txt");

    for (int i = 0; i < 10; i++) {
        file >> s.firstname >> s.lastname >> s.gpa;
        students.push_back(s);
    }

    file.close();

    display(students);

    return 0;
}

#include <iostream>
using namespace std;

int main()
{
    int quantity;
    float unitprice, extendedprice, tax, total;

    cout << "Enter quantity: ";
    cin >> quantity;

    if (quantity >= 1000)
        unitprice = 3.00;
    else
        unitprice = 5.00;

    extendedprice = quantity * unitprice;
    tax = extendedprice * 0.07;
    total = extendedprice + tax;

    cout << "Quantity: " << quantity << endl;
    cout << "Unit price: $" << unitprice << endl;
    cout << "Extended price: $" << extendedprice << endl;
    cout << "Tax: $" << tax << endl;
    cout << "Total: $" << total << endl;

    return 0;
}

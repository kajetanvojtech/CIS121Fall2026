#include <iostream>
#include <string>
using namespace std;

int main()
{
    string lastname;
    int dependents;
    float grossincome, adjustedgrossincome, taxrate, incometax;

    cout << "Enter last name: ";
    cin >> lastname;

    cout << "Enter number of dependents: ";
    cin >> dependents;

    cout << "Enter gross income: ";
    cin >> grossincome;

    adjustedgrossincome = grossincome - (dependents * 12000);

    if (adjustedgrossincome > 50000)
        taxrate = 0.20;
    else
        taxrate = 0.10;

    incometax = adjustedgrossincome * taxrate;

    if (incometax < 0)
        incometax = 100;

    cout << "Last name: " << lastname << endl;
    cout << "Gross income: $" << grossincome << endl;
    cout << "Dependents: " << dependents << endl;
    cout << "Adjusted gross income: $" << adjustedgrossincome << endl;
    cout << "Income tax: $" << incometax << endl;

    return 0;
}

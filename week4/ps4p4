#include <iostream>
#include <string>
using namespace std;

int main()
{
    string name;
    float cost, warranty, total;

    cout << "Enter appliance name: ";
    cin >> name;

    cout << "Enter appliance cost: ";
    cin >> cost;

    if (cost > 1000)
        warranty = cost * 0.10;
    else
        warranty = cost * 0.05;

    total = cost + warranty;

    cout << "Appliance: " << name << endl;
    cout << "Cost: $" << cost << endl;
    cout << "Warranty: $" << warranty << endl;
    cout << "Total: $" << total << endl;

    return 0;
}

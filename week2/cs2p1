#include <iostream>
using namespace std;

int main() {
    int quantity;
    double unitPrice, extendedPrice;

    // Input
    cout << "Enter quantity: ";
    cin >> quantity;

    cout << "Enter unit price: $";
    cin >> unitPrice;

    // Process
    extendedPrice = quantity * unitPrice;

    // Output
    cout << "Extended price: $" << extendedPrice << endl;

    return 0;
}

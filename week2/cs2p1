#include <iostream>
using namespace std;

int main() {
    int quantity;
    float unitprice, extendedprice;

    // Input
    cout << "Enter quantity: ";
    cin >> quantity;

    cout << "Enter unit price: $";
    cin >> unitprice;

    // Process
    extendedprice = quantity * unitprice;

    // Output
    cout << "Extended price: $" << extendedprice << endl;

    return 0;
}

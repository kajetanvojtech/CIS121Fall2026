#include <iostream>
using namespace std;

int main() {
    float length, width, area, circumference;

    // Input
    cout << "Enter length: ";
    cin >> length;

    cout << "Enter width: ";
    cin >> width;

    // Process
    area = length * width;
    circumference = 2 * length + 2 * width;

    // Output
    cout << "Area: " << area << endl;
    cout << "Circumference: " << circumference << endl;

    return 0;
}

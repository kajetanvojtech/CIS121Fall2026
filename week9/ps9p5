
#include <iostream>
using namespace std;

double creditCost(char code) {
    if (code == 'I')
        return 250;
    else if (code == 'O')
        return 550;
    else
        return 0;
}

double tuitionCost(double credits, double rate) {
    return credits * rate;
}

int main() {
    char lastName[50], code;
    double credits, tuition;
    double totalTuition = 0;

    while (cin >> lastName >> credits >> code) {
        tuition = tuitionCost(credits, creditCost(code));

        cout << lastName << " Tuition: $" << tuition << endl;

        totalTuition += tuition;
    }

    cout << "Total Tuition: $" << totalTuition << endl;

    return 0;
}


#include <iostream>
using namespace std;

double payRate(char code) {
    if (code == 'L')
        return 25;
    else if (code == 'A')
        return 30;
    else if (code == 'J')
        return 50;
    else
        return 0;
}

double grossPay(double hours, double rate) {
    if (hours > 40)
        return 40 * rate + (hours - 40) * rate * 1.5;
    else
        return hours * rate;
}

int main() {
    char lastName[50], code;
    double hours, pay;
    double totalPay = 0;

    while (cin >> lastName >> code >> hours) {
        pay = grossPay(hours, payRate(code));

        cout << lastName << " Gross Pay: $" << pay << endl;

        totalPay += pay;
    }

    cout << "Total Gross Pay: $" << totalPay << endl;

    return 0;
}

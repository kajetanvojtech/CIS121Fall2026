#include <iostream>
using namespace std;

int main()
{
    int partnumber, quantity;
    double cost, total;

    cout << "Enter part number: ";
    cin >> partnumber;

    cout << "Enter quantity: ";
    cin >> quantity;

    if (partnumber == 10 && quantity > 1000)
        cost = 1;
    else if (partnumber == 99 && quantity > 500)
        cost = 2;
    else
        cost = 5;

    total = quantity * cost;

    cout << "Part number: " << partnumber << endl;
    cout << "Cost per unit: $" << cost << endl;
    cout << "Total: $" << total << endl;

    return 0;
}

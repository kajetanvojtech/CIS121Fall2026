
#include <iostream>
using namespace std;

double labfee(char department[], int course)
{
    if (department[0] == 'C' && department[1] == 'I' && department[2] == 'S')
    {
        if (course == 101)
            return 50;
        else if (course == 121)
            return 100;
    }
    else if (department[0] == 'M' && department[1] == 'A' && department[2] == 'T')
    {
        if (course == 111)
            return 25;
        else if (course == 112)
            return 35;
    }
    else if (department[0] == 'E' && department[1] == 'N' && department[2] == 'G')
    {
        if (course == 100)
            return 55;
    }

    return 50;
}

int main()
{
    char department[20];
    int course, count = 0;
    double fee, total = 0;

    while (cin >> department >> course)
    {
        fee = labfee(department, course);

        cout << "Department: " << department << endl;
        cout << "Course: " << course << endl;
        cout << "Lab fee: $" << fee << endl;

        total = total + fee;
        count++;
    }

    cout << "Total fees: $" << total << endl;

    if (count > 0)
        cout << "Average fee: $" << total / count << endl;

    return 0;
}

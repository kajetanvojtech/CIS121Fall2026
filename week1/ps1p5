#include <iostream>
using namespace std;

int main() {
    float num1;
    float num2;
    float sum;
    float product;
    float difference;

    cout << "Enter the first number: ";
    cin >> num1;

    cout << "Enter the second number: ";
    cin >> num2;

    sum = (num1 + num2);
    product = (num1 * num2);
    difference = (num1 - num2);

    cout << "The sum is: " << sum << endl;
    cout << "The product is: " << product << endl;
    cout << "The difference is: " << difference << endl;

    return 0;
}

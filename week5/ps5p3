
#include <iostream>
using namespace std;

int main()
{
    string lastname;
    char jobcode;
    double hours, payrate, total;

    cout << "Enter last name: ";
    cin >> lastname;

    cout << "Enter hours worked: ";
    cin >> hours;

    cout << "Enter job code: ";
    cin >> jobcode;

    if (jobcode == 'E')
        payrate = 25.00;
    else if (jobcode == 'J')
        payrate = 20.00;
    else if (jobcode == 'A')
        payrate = 15.00;
    else
    {
        cout << "Invalid job code";
        return 0;
    }

    total = hours * payrate;

    cout << "Last Name: " << lastname << endl;
    cout << "Hours Worked: " << hours << endl;
    cout << "Pay Rate: $" << payrate << endl;
    cout << "Total Pay: $" << total << endl;

    return 0;
}
